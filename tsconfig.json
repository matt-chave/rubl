{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "declaration": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "inlineSourceMap": true,
    "inlineSources": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "outDir": "dist",
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"]
  },
  "include": [
    "infra/**/*.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "learn/**/*.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "apps/dwt-operator-ui/src/**/*.ts",
    "apps/dwt-operator-ui/src/**/*.tsx",
    "apps/dwt-onboarding-ui/src/**/*.ts",
    "apps/dwt-onboarding-ui/src/**/*.tsx",
    "apps/dwt-widget-demo/src/**/*.ts",
    "apps/dwt-widget-demo/src/**/*.tsx"
  ],
  "exclude": ["cdk.out", "node_modules", "dist", "**/dist/**", "**/dist-types/**"]
}
